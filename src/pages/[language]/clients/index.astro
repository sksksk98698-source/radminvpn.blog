---
import { Icon } from "astro-icon/components";
import Container from "@/components/atoms/container/Container.astro";
import Hero from "@/components/molecules/hero/Hero.astro";
import { featuredAirport } from "@/data/airports";
import { proxyClients } from "@/data/clients";
import BlogBase from "@/layouts/BlogBase.astro";
import { defaultLocale, languages } from "@/utils/i18n.ts";

export function getStaticPaths() {
	return Object.keys(languages).map((language) => ({
		params: { language },
	}));
}

const locale = Astro.currentLocale || defaultLocale;
const isZh = locale.startsWith("zh");

const title = isZh
  ? "2026 机场代理客户端大全【Windows / Mac / iOS / Android 下载与使用指南】"
  : "2026 Proxy Clients Hub: Clash, Shadowrocket, v2rayN Download & Setup";

const description = isZh
  ? "整理 Windows、macOS、Android、iOS 全平台主流代理客户端。包含 Clash Verge Rev、Shadowrocket（小火箭）、v2rayN、sing-box 下载源、内核说明及机场订阅导入教程。"
  : "Download and configure leading proxy clients for all platforms: Clash Verge Rev, Shadowrocket, v2rayN, FlClash, and sing-box with full setup guides.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `https://radminvpn.blog/${locale}/clients/`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": isZh ? "首页" : "Home",
        "item": `https://radminvpn.blog/${locale}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": isZh ? "客户端" : "Clients Hub",
        "item": `https://radminvpn.blog/${locale}/clients/`
      }
    ]
  }
};
---

<BlogBase title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Hero>
    <div slot="beforeHeadline" class="mx-auto flex items-center gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 flex items-center gap-1.5">
        <Icon name="material-symbols:devices-outline-rounded" size={16} />
        <span>多平台官方开源源收录</span>
      </span>
    </div>

    <div class="container mx-auto tracking-tight leading-tight text-center max-w-4xl" slot="headline">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black mb-4">
        {isZh ? "机场代理客户端全平台指南" : "Proxy Clients & Setup Hub"}
      </h1>
      <p class="text-base sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        工欲善其事，必先利其器。快速挑选兼容你所用机场订阅（Clash / SS / VLESS / Trojan）的高颜值、稳定代理软件。
      </p>
    </div>
  </Hero>

  <Container>
    <main class="pb-24 max-w-5xl mx-auto">
      <!-- Fast Recommendation Box -->
      <section class="mb-12 p-6 rounded-2xl bg-gradient-to-r from-primary/10 via-background to-card border border-primary/30 flex flex-wrap items-center justify-between gap-4">
        <div class="max-w-xl">
          <div class="text-xs font-bold text-primary mb-1">{isZh ? "新手小白免折腾建议" : "Beginner Tip"}</div>
          <h3 class="text-lg font-black text-foreground">{isZh ? "不想研究复杂的客户端订阅配置？" : "Prefer Zero-Configuration Proxy Access?"}</h3>
          <p class="text-xs text-muted-foreground mt-1">
            {isZh ? `推荐使用 ${featuredAirport.name}，不仅提供 Windows、macOS、Android 自研一键登录客户端，同时也完整支持第三方 Clash、Shadowrocket 订阅链接。` : `We recommend ${featuredAirport.name}, offering custom one-click login clients for Windows, macOS, Android, as well as universal Clash & Shadowrocket subscriptions.`}
          </p>
        </div>
        <a
          href={featuredAirport.affUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="px-5 py-2.5 rounded-xl text-xs font-bold bg-primary text-primary-foreground hover:bg-primary/90 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>{isZh ? "查看光速云自研客户端" : "View Custom Clients"}</span>
          <Icon name="material-symbols:open-in-new-rounded" size={14} />
        </a>
      </section>

      <!-- Clients Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {proxyClients.map((client) => (
          <div class="p-6 rounded-2xl bg-card border border-border hover:border-primary/40 transition shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <h3 class="text-xl font-bold text-foreground">{client.name}</h3>
                  <div class="text-xs text-muted-foreground mt-0.5">{isZh ? "核心架构:" : "Kernel:"} <code class="text-primary">{client.kernel}</code></div>
                </div>
                {client.isPopular && (
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    {isZh ? "首选推荐" : "Recommended"}
                  </span>
                )}
              </div>

              <!-- Platforms -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {client.platforms.map((p) => (
                  <span class="px-2 py-0.5 rounded text-[11px] bg-muted font-mono uppercase text-muted-foreground">
                    {p}
                  </span>
                ))}
              </div>

              <!-- Features -->
              <ul class="space-y-1.5 text-xs text-muted-foreground mb-4">
                {client.features.map((feat) => (
                  <li class="flex items-center gap-1.5">
                    <Icon name="material-symbols:check-rounded" class="text-primary shrink-0" size={14} />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <p class="text-xs text-muted-foreground bg-muted/40 p-2.5 rounded-lg border border-border/60 mb-6">
                <strong>{isZh ? "定位建议：" : "Target: "}</strong> {client.recommendedFor}
              </p>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-border">
              <span class="text-xs text-muted-foreground">{isZh ? "渠道:" : "Source:"} {client.officialSource}</span>
              <a
                href={client.downloadUrl}
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center gap-1 px-4 py-2 rounded-xl text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition shadow-sm"
              >
                <span>{isZh ? "官方获取" : "Get App"}</span>
                <Icon name="material-symbols:download-rounded" size={14} />
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- General Setup Tutorial Summary -->
      <section class="p-6 sm:p-8 rounded-2xl bg-card border border-border">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <Icon name="material-symbols:menu-book-outline-rounded" class="text-primary" size={22} />
          <span>{isZh ? "三步极速导入机场订阅通用教程" : "3-Step Universal Subscription Setup Guide"}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-muted/30 border border-border/80">
            <div class="size-7 rounded-lg bg-primary text-primary-foreground font-black flex items-center justify-center text-sm mb-3">1</div>
            <h4 class="font-bold text-foreground mb-1">复制机场订阅链接</h4>
            <p class="text-muted-foreground leading-relaxed">
              在您的机场后台（如光速云、飞猫云）用户中心，找到“一键导入”或“复制订阅链接（Clash / v2rayN）”。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-muted/30 border border-border/80">
            <div class="size-7 rounded-lg bg-primary text-primary-foreground font-black flex items-center justify-center text-sm mb-3">2</div>
            <h4 class="font-bold text-foreground mb-1">粘贴至客户端并拉取</h4>
            <p class="text-muted-foreground leading-relaxed">
              打开 Clash Verge Rev 或 Shadowrocket，在配置（Profile/订阅）管理页面粘贴链接，点击“保存并拉取节点”。
            </p>
          </div>
          <div class="p-4 rounded-xl bg-muted/30 border border-border/80">
            <div class="size-7 rounded-lg bg-primary text-primary-foreground font-black flex items-center justify-center text-sm mb-3">3</div>
            <h4 class="font-bold text-foreground mb-1">开启系统代理与规则分流</h4>
            <p class="text-muted-foreground leading-relaxed">
              选择延时较低的香港、日本或新加坡节点，勾选“系统代理”，即可开启高速安全的全球网络畅联。
            </p>
          </div>
        </div>
      </section>
    </main>
  </Container>
</BlogBase>
