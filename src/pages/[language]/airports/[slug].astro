---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import Container from "@/components/atoms/container/Container.astro";
import SpeedtestViewer from "@/components/molecules/speedtest-viewer/SpeedtestViewer.astro";
import UnlockGallery from "@/components/molecules/unlock-gallery/UnlockGallery.astro";
import { airportBrands } from "@/data/airports";
import BlogBase from "@/layouts/BlogBase.astro";
import type { AirportBrand } from "@/types/airport";
import { defaultLocale, languages } from "@/utils/i18n.ts";

export async function getStaticPaths() {
	return Object.keys(languages).flatMap((language) =>
		airportBrands.map((brand) => ({
			params: { language, slug: brand.id },
			props: { brand },
		})),
	);
}

export interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;
const locale = Astro.currentLocale || defaultLocale;
const isZh = locale.startsWith("zh");

const title = isZh
  ? `${brand.name} 2026 深度测评：节点测速、套餐价格与优惠码【实测】`
  : `${brand.name} Review 2026: Speedtest Proofs, Pricing & Setup Guide`;

const description = isZh
  ? `深度实测 ${brand.name} 线路质量。起步价格 ${brand.startingPrice}，支持 ${brand.protocols.join("/")}。查看真实节点测速大图、流媒体/ChatGPT 解锁情况及最新优惠码。`
  : `In-depth review of ${brand.name} with real speed test proofs, streaming unlock results, ${brand.startingPrice} pricing, and full setup guide.`;

const currentUrl = `https://radminvpn.blog/${locale}/airports/${brand.id}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": isZh ? "首页" : "Home",
          "item": `https://radminvpn.blog/${locale}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": isZh ? "机场品牌库" : "Airports Directory",
          "item": `https://radminvpn.blog/${locale}/airports/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${brand.name} 测评`,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "Product",
      "name": `${brand.name} 加速网络服务`,
      "description": brand.summary,
      "brand": {
        "@type": "Brand",
        "name": brand.name
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "CNY",
        "lowPrice": brand.startingPrice.replace(/[^0-9.]/g, '') || "10",
        "offerCount": brand.packages.length
      },
      "review": {
        "@type": "Review",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": brand.rank === 1 ? "5.0" : (brand.rank <= 5 ? "4.8" : "4.5"),
          "bestRating": "5"
        },
        "author": {
          "@type": "Organization",
          "name": "Radmin VPN Lab"
        },
        "datePublished": "2026-08-12",
        "reviewBody": brand.summary
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": brand.faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BlogBase title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <Container>
    <main class="py-8 sm:py-12 max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-8">
        <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-foreground">{isZh ? "首页" : "Home"}</a>
        <span>/</span>
        <a href={getRelativeLocaleUrl(locale, "/airports/")} class="hover:text-foreground">{isZh ? "机场品牌库" : "Airports"}</a>
        <span>/</span>
        <span class="text-foreground font-medium">{isZh ? `${brand.name} 测评` : `${brand.name} Review`}</span>
      </nav>

      <!-- Header Section -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div class="flex items-center gap-3">
            <span class={`flex items-center justify-center size-9 rounded-xl text-sm font-extrabold ${brand.rank === 1 ? 'bg-primary text-primary-foreground shadow-sm' : 'bg-muted text-muted-foreground'}`}>
              #{brand.rank}
            </span>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-foreground">
              {isZh ? `${brand.name} 深度测评与使用指南` : `${brand.name} Review & Setup Guide`}
            </h1>
          </div>

          <div class="flex items-center gap-2">
            {brand.couponCode && (
              <span class="px-3 py-1 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                {isZh ? "专属优惠码" : "Code"}: {brand.couponCode}
              </span>
            )}
            <span class="px-3 py-1 rounded-lg text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
              {brand.startingPrice}
            </span>
          </div>
        </div>

        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
          {brand.summary}
        </p>
      </header>

      <!-- GEO Direct Answer Summary Card -->
      <section class="mb-10 p-6 rounded-2xl bg-gradient-to-br from-primary/10 via-background to-card border border-primary/30 shadow-sm">
        <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
          <Icon name="material-symbols:verified-outline-rounded" class="text-primary" size={20} />
          <span>{isZh ? "【实测速评结论与核心参数】" : "[Benchmark Summary & Key Specs]"}</span>
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs mb-4">
          <div class="p-3 rounded-xl bg-card border border-border">
            <div class="text-muted-foreground">{isZh ? "线路类型" : "Network Type"}</div>
            <div class="font-bold text-foreground mt-1">{brand.lineTypes.join(" + ")}</div>
          </div>
          <div class="p-3 rounded-xl bg-card border border-border">
            <div class="text-muted-foreground">{isZh ? "核心协议" : "Protocols"}</div>
            <div class="font-bold text-foreground mt-1">{brand.protocols.join(" / ")}</div>
          </div>
          <div class="p-3 rounded-xl bg-card border border-border">
            <div class="text-muted-foreground">{isZh ? "客户端支持" : "Client Support"}</div>
            <div class="font-bold text-foreground mt-1">{brand.clientSupport.customClient ? (isZh ? "自研客户端 + 通用订阅" : "Custom App + Generic Sub") : (isZh ? "支持主流第三方订阅" : "Third-party Subs")}</div>
          </div>
          <div class="p-3 rounded-xl bg-card border border-border">
            <div class="text-muted-foreground">{isZh ? "入门资费" : "Starting Price"}</div>
            <div class="font-bold text-primary mt-1">{brand.startingPrice}</div>
          </div>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed">
          <strong>{isZh ? "核心特征：" : "Highlights: "}</strong> {brand.uniqueSellingPoint}
        </p>
      </section>

      <!-- Speedtest Proof Section (If Available) -->
      {brand.speedtest && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <Icon name="material-symbols:speed-outline-rounded" class="text-emerald-500" size={24} />
            <span>{isZh ? "晚高峰节点测速真实证据" : "Peak Hours Speedtest Evidence"}</span>
          </h2>
          <SpeedtestViewer speedtest={brand.speedtest} brandName={brand.name} />
        </section>
      )}

      <!-- Unlock Evidence Section (If Available) -->
      {brand.unlockImages && brand.unlockImages.length > 0 && (
        <section class="mb-10">
          <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
            <Icon name="material-symbols:smart-display-outline-rounded" class="text-primary" size={24} />
            <span>{isZh ? "流媒体与 ChatGPT 原生解锁实测图集" : "Streaming & AI Unlock Verification"}</span>
          </h2>
          <UnlockGallery images={brand.unlockImages} brandName={brand.name} />
        </section>
      )}

      <!-- Packages Section -->
      <section class="mb-10">
        <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
          <Icon name="material-symbols:payments-outline-rounded" class="text-primary" size={24} />
          <span>{isZh ? "套餐方案与价格体系" : "Plans & Packages"}</span>
        </h2>
        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-muted/50 border-b border-border text-muted-foreground">
              <tr>
                <th class="p-3.5">{isZh ? "套餐名称" : "Plan"}</th>
                <th class="p-3.5">{isZh ? "计费价格" : "Price"}</th>
                <th class="p-3.5">{isZh ? "高速流量" : "Bandwidth"}</th>
                <th class="p-3.5">{isZh ? "计费周期" : "Period"}</th>
                <th class="p-3.5 text-right">{isZh ? "订购建议" : "Action"}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60">
              {brand.packages.map((pkg) => (
                <tr class={pkg.isPopular ? "bg-primary/5 font-medium" : ""}>
                  <td class="p-3.5 font-bold flex items-center gap-1.5">
                    {pkg.name}
                    {pkg.isPopular && <span class="px-1.5 py-0.5 rounded text-[10px] bg-primary text-primary-foreground font-semibold">{isZh ? "推荐" : "Popular"}</span>}
                  </td>
                  <td class="p-3.5 text-primary font-bold">{pkg.price}</td>
                  <td class="p-3.5">{pkg.traffic}</td>
                  <td class="p-3.5">{pkg.period}</td>
                  <td class="p-3.5 text-right">
                    <a
                      href={brand.affUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs bg-primary text-primary-foreground hover:bg-primary/90 transition"
                    >
                      <span>{isZh ? "前往订购" : "Order"}</span>
                      <Icon name="material-symbols:open-in-new-rounded" size={12} />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Pros & Cons -->
      <section class="mb-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-5 rounded-2xl bg-card border border-border">
          <h3 class="text-base font-bold text-foreground mb-3 flex items-center gap-2">
            <Icon name="material-symbols:check-circle-outline-rounded" class="text-emerald-500" size={20} />
            <span>{isZh ? "核心优势 (Pros)" : "Pros & Advantages"}</span>
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-muted-foreground">
            {brand.pros.map((pro) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border">
          <h3 class="text-base font-bold text-foreground mb-3 flex items-center gap-2">
            <Icon name="material-symbols:warning-outline-rounded" class="text-amber-500" size={20} />
            <span>{isZh ? "注意事项与局限 (Cons)" : "Cons & Limitations"}</span>
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-muted-foreground">
            {brand.cons.map((con) => (
              <li class="flex items-start gap-2">
                <span class="text-amber-500 font-bold">!</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Target Audience -->
      <section class="mb-10 p-6 rounded-2xl bg-card border border-border">
        <h3 class="text-lg font-bold mb-3 flex items-center gap-2">
          <Icon name="material-symbols:group-outline-rounded" class="text-primary" size={20} />
          <span>{isZh ? "人群画像：适合谁与不适合谁" : "Target Audience Analysis"}</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div>
            <div class="font-bold text-emerald-600 dark:text-emerald-400 mb-2">{isZh ? "适合人群：" : "Recommended for:"}</div>
            <ul class="list-disc list-inside space-y-1 text-muted-foreground">
              {brand.targetAudience.map((aud) => (
                <li>{aud}</li>
              ))}
            </ul>
          </div>
          <div>
            <div class="font-bold text-rose-500 mb-2">{isZh ? "不适合人群：" : "Not recommended for:"}</div>
            <ul class="list-disc list-inside space-y-1 text-muted-foreground">
              {brand.notSuitableFor.map((aud) => (
                <li>{aud}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2">
          <Icon name="material-symbols:quiz-outline-rounded" class="text-primary" size={24} />
          <span>{isZh ? "常见问题与使用答疑 (FAQ)" : "Frequently Asked Questions (FAQ)"}</span>
        </h2>
        <div class="space-y-3">
          {brand.faq.map((item) => (
            <div class="p-4 rounded-xl bg-card border border-border">
              <h4 class="text-sm font-bold text-foreground mb-1.5">{item.q}</h4>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Sticky / Final CTA Card -->
      <section class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-primary/20 via-blue-600/10 to-teal-400/10 border border-primary/40 shadow-lg text-center">
        <h3 class="text-xl sm:text-2xl font-extrabold text-foreground mb-2">
          {isZh ? `即刻开启 ${brand.name} 高速网络体验` : `Experience High-Speed Connection with ${brand.name}`}
        </h3>
        <p class="text-xs sm:text-sm text-muted-foreground max-w-lg mx-auto mb-6">
          {isZh ? "专线低延迟节点，支持多设备通用订阅导入。使用专属优惠码结算立享优惠折扣。" : "Low-latency IEPL nodes with full client support. Apply promo code at checkout for maximum discounts."}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={brand.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-6 py-3 rounded-xl text-sm font-bold bg-primary text-primary-foreground hover:bg-primary/90 shadow-md transition flex items-center gap-2"
          >
            <span>{isZh ? `访问 ${brand.name} 官方网站` : `Visit ${brand.name} Official Website`}</span>
            <Icon name="material-symbols:open-in-new-rounded" size={16} />
          </a>
          <a
            href={getRelativeLocaleUrl(locale, "/airports/")}
            class="px-5 py-3 rounded-xl text-sm font-semibold border border-border hover:bg-muted text-foreground transition"
          >
            {isZh ? "返回品牌库全览" : "Back to Directory"}
          </a>
        </div>
        <div class="text-[11px] text-muted-foreground mt-4">
          {isZh ? "含推广标识 · 优惠与测速基于标注日期真实资料 · 支付价格以官网最终结算为准" : "Contains sponsored affiliate link. Tested on verified date. Prices subject to final official checkout."}
        </div>
      </section>
    </main>
  </Container>
</BlogBase>
