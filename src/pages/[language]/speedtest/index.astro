---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import Container from "@/components/atoms/container/Container.astro";
import SpeedtestViewer from "@/components/molecules/speedtest-viewer/SpeedtestViewer.astro";
import Hero from "@/components/molecules/hero/Hero.astro";
import { speedtestedAirports } from "@/data/airports";
import BlogBase from "@/layouts/BlogBase.astro";
import { defaultLocale, languages } from "@/utils/i18n.ts";

export function getStaticPaths() {
	return Object.keys(languages).map((language) => ({
		params: { language },
	}));
}

const locale = Astro.currentLocale || defaultLocale;
const isZh = locale.startsWith("zh");

const title = isZh
  ? "2026 机场节点测速实测报告大全【17 家晚高峰大图证据链】"
  : "2026 Proxy Speedtest Proofs & Benchmark Gallery (17 Providers)";

const description = isZh
  ? "汇集 17 家主流机场 2026 晚高峰节点实测测速报告。涵盖光速云、飞猫云、微风网络、星岛梦等，保留原始1122×1402高清长图与测试时间戳，真实可溯源。"
  : "Real speedtest screenshots and latency proofs for 17 leading proxy services tested during peak hours. Full resolution PNGs with timestamps preserved.";
---

<BlogBase title={title} description={description}>
  <Hero>
    <div slot="beforeHeadline" class="mx-auto flex items-center gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5">
        <Icon name="material-symbols:speed-outline-rounded" size={16} />
        <span>17 份实测大图无裁剪存档</span>
      </span>
    </div>

    <div class="container mx-auto tracking-tight leading-tight text-center max-w-4xl" slot="headline">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black mb-4">
        {isZh ? "机场节点测速实测报告中心" : "Proxy Speedtest Evidence Hub"}
      </h1>
      <p class="text-base sm:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        真实可比的晚高峰下载速率、TLS RTT 延迟与丢包率全景。每一张测速图均保留原始时间戳水印，拒绝虚假 P 图。
      </p>
    </div>
  </Hero>

  <Container>
    <main class="pb-24 max-w-4xl mx-auto">
      <!-- Methodology & Testing Condition -->
      <div class="mb-10 p-6 rounded-2xl bg-card border border-border shadow-sm text-xs sm:text-sm text-muted-foreground leading-relaxed">
        <h3 class="text-base font-bold text-foreground mb-2 flex items-center gap-2">
          <Icon name="material-symbols:science-outline" class="text-primary" size={20} />
          <span>实测方法与证据说明规范</span>
        </h3>
        <p class="mb-2">
          本专题汇聚的 17 份测速截图于 <strong>2026-08-11 晚高峰时段</strong> 使用专业 MAI-TEST-BOT 测速引擎采集。测试覆盖香港、日本、新加坡、台湾、美国等核心枢纽节点。
        </p>
        <p class="text-[11px] text-muted-foreground border-t border-border pt-2 mt-2">
          * 单日实测快照仅能反映当次测试网络环境，不可单独推断长期可用率。建议优先挑选支持自研客户端一键测速或提供短期月付方案的服务商。
        </p>
      </div>

      <!-- Quick Brand Jump Pills -->
      <div class="mb-10 flex flex-wrap gap-2">
        {speedtestedAirports.map((b) => (
          <a
            href={`#${b.id}`}
            class="px-3 py-1.5 rounded-lg text-xs font-medium bg-muted hover:bg-primary hover:text-primary-foreground border border-border transition"
          >
            {b.name}
          </a>
        ))}
      </div>

      <!-- Speedtest Reports List -->
      <div class="space-y-12">
        {speedtestedAirports.map((brand) => (
          <section id={brand.id} class="pt-4">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
              <h2 class="text-2xl font-black text-foreground flex items-center gap-2">
                <span>{brand.name}</span>
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-bold">#{brand.rank}</span>
              </h2>
              <div class="flex items-center gap-2">
                <a
                  href={brand.affUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition flex items-center gap-1"
                >
                  <span>直达官网</span>
                  <Icon name="material-symbols:open-in-new-rounded" size={13} />
                </a>
                <a
                  href={getRelativeLocaleUrl(locale, `/airports/${brand.id}/`)}
                  class="px-3 py-1.5 rounded-lg text-xs font-medium border border-border hover:bg-muted text-foreground transition"
                >
                  查看完整测评
                </a>
              </div>
            </div>

            {brand.speedtest && (
              <SpeedtestViewer speedtest={brand.speedtest} brandName={brand.name} />
            )}
          </section>
        ))}
      </div>
    </main>
  </Container>
</BlogBase>
