---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import uniqolor from "uniqolor";
import AvatarBadge from "@/components/atoms/avatar-badge/AvatarBadge.astro";
import Container from "@/components/atoms/container/Container.astro";
import SpotlightCard from "@/components/atoms/spotlight-card/SpotlightCard.astro";
import SpotlightCardsGallery from "@/components/atoms/spotlight-cards-gallery/SpotlightCardsGallery.astro";
import Hero from "@/components/molecules/hero/Hero.astro";
import GlobalSearchInput from "@/components/organisms/global-search-input/GlobalSearchInput.astro";
import { featuredAirport, top10Airports, speedtestedAirports } from "@/data/airports";
import { getLocale, type TranslationKey, useTranslations } from "@/i18n/i18n";
import BlogBase from "@/layouts/BlogBase.astro";
import {
	dateSortedLocaleRelatedPosts,
	sortedPostCategoryies,
} from "@/utils/getPosts.ts";
import { currentLocaleWebsiteConfig } from "@/utils/getWebsiteConfig.ts";
import { defaultLocale, languages, stripLanguageCode } from "@/utils/i18n.ts";
import toSnakeCase from "@/utils/toSnakeCase.ts";

const locale = Astro.currentLocale || defaultLocale;
const isZh = locale.startsWith("zh");
const t = useTranslations(getLocale(locale));

const websiteConfig = (await currentLocaleWebsiteConfig(locale)).data;
const { brand } = websiteConfig;

const categoriesLists = sortedPostCategoryies.map((category) => ({
	type: category,
	posts: dateSortedLocaleRelatedPosts(getLocale(locale))
		.filter((post) => post.data.category === category)
		.sort(
			(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
		),
}));

export function getStaticPaths() {
	return Object.keys(languages).map((language) => ({
		params: { language },
	}));
}
---

<BlogBase>
  <slot name="head">
    <link href={`${import.meta.env.BASE_URL}pagefind/pagefind-ui.css`} rel="stylesheet">
    <script is:inline src={`${import.meta.env.BASE_URL}pagefind/pagefind-ui.js`}></script>
  </slot>

  <!-- Hero with Signature Avatar Visual -->
  <Hero>
    <div slot="beforeHeadline" class="mx-auto flex flex-col items-center gap-3">
      <!-- Original Theme Avatar Badge Visual -->
      <AvatarBadge statusText="42 家机场节点实测已收录" />
    </div>

    <div class="container mx-auto tracking-tight leading-tight text-center max-w-4xl" slot="headline">
      <div class="mb-3">
        <span class="bg-gradient-to-r from-primary via-blue-500 to-teal-400 bg-clip-text text-transparent font-black text-4xl sm:text-6xl md:text-7xl">
          {brand.name}
        </span>
      </div>
      <p class="text-base sm:text-xl font-medium tracking-normal text-muted-foreground mt-3 leading-relaxed max-w-2xl mx-auto">
        {isZh ? "专注高端网络加速评测、IEPL专线机场实测证据链与 Radmin VPN 远程虚拟组网指南" : brand.slogan}
      </p>

      <!-- Conversion Action Hub -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "/ranking/")}
          class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-primary text-primary-foreground hover:bg-primary/90 shadow-md transition flex items-center gap-1.5"
        >
          <Icon name="material-symbols:trophy-outline-rounded" size={18} />
          <span>2026 机场推荐排行榜</span>
        </a>

        <a
          href={featuredAirport.affUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-amber-500/10 hover:bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 transition flex items-center gap-1.5"
        >
          <Icon name="material-symbols:bolt-outline-rounded" size={18} />
          <span>第一主推: {featuredAirport.name}（码: {featuredAirport.couponCode}）</span>
        </a>

        <a
          href={getRelativeLocaleUrl(locale, "/airports/")}
          class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-medium border border-border hover:bg-muted text-foreground transition"
        >
          浏览 42 家品牌库
        </a>
      </div>
    </div>

    {import.meta.env.PROD && <GlobalSearchInput placeholderText={t("awake_quiet_ape_emerge")}/>}
  </Hero>

  <!-- High-Converting Spotlight Showcase Hub -->
  <section class="pb-16">
    <Container>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-black text-foreground flex items-center gap-2">
          <Icon name="material-symbols:auto-awesome-outline-rounded" class="text-primary" size={24} />
          <span>精选加速与测评专区</span>
        </h2>
        <a href={getRelativeLocaleUrl(locale, "/airports/")} class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
          <span>查看全部 42 家品牌</span>
          <Icon name="material-symbols:arrow-forward-rounded" size={14} />
        </a>
      </div>

      <SpotlightCardsGallery minCardWidth={500}>
        <!-- Card 1: 光速云 (Featured Super Spotlight) -->
        <SpotlightCard themeColor="#3a86ff" class="group p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-black bg-primary text-primary-foreground flex items-center gap-1">
                <Icon name="material-symbols:award-star-outline-rounded" size={14} />
                <span>综合第一主推</span>
              </span>
              <span class="text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                优惠码: {featuredAirport.couponCode}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-black text-foreground mb-2">
              <a href={getRelativeLocaleUrl(locale, `/airports/${featuredAirport.id}/`)} class="hover:text-primary transition">
                {featuredAirport.name}
              </a>
            </h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mb-4">
              IEPL专线 + 企业级内网专线双架构。年付折合约 <strong>8 元/月</strong> 起，独家 <strong>147 元永久 247GB</strong> 套餐。全平台自研客户端一键连接，支持 Clash / 小火箭通用订阅与 5 张真实解锁实测。
            </p>

            <div class="flex flex-wrap gap-1.5 text-xs mb-6">
              <span class="px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">双专线</span>
              <span class="px-2 py-0.5 rounded bg-muted text-muted-foreground">VLESS 协议</span>
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 font-medium">ChatGPT / TikTok 解锁</span>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-border">
            <a
              href={featuredAirport.affUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-primary text-primary-foreground hover:bg-primary/90 transition shadow-sm"
            >
              <span>直达光速云官网</span>
              <Icon name="material-symbols:open-in-new-rounded" size={14} />
            </a>
            <a
              href={getRelativeLocaleUrl(locale, `/airports/${featuredAirport.id}/`)}
              class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-medium border border-border hover:bg-muted text-foreground transition"
            >
              查看深度测评
            </a>
          </div>
        </SpotlightCard>

        <!-- Card 2: 2026 Top Picks Overview -->
        <SpotlightCard themeColor="#f59e0b" class="group p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-amber-500 flex items-center gap-1">
                <Icon name="material-symbols:trophy-outline-rounded" size={16} />
                <span>年度权威榜单</span>
              </span>
              <a href={getRelativeLocaleUrl(locale, "/ranking/")} class="text-xs text-primary hover:underline">查看完整 Top 10</a>
            </div>

            <h3 class="text-2xl font-black text-foreground mb-3">
              2026 专线机场前列品牌
            </h3>

            <ul class="space-y-2.5 text-xs sm:text-sm mb-6">
              {top10Airports.slice(1, 4).map((b) => (
                <li class="flex items-center justify-between p-2 rounded-lg bg-muted/40 hover:bg-muted/70 transition">
                  <div class="flex items-center gap-2">
                    <span class="size-5 rounded bg-muted text-[10px] font-bold flex items-center justify-center">#{b.rank}</span>
                    <a href={getRelativeLocaleUrl(locale, `/airports/${b.id}/`)} class="font-bold text-foreground hover:text-primary">
                      {b.name}
                    </a>
                  </div>
                  <span class="text-primary font-semibold">{b.startingPrice}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex items-center gap-2 pt-4 border-t border-border">
            <a
              href={getRelativeLocaleUrl(locale, "/ranking/")}
              class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-muted hover:bg-primary hover:text-primary-foreground text-foreground transition"
            >
              <span>查看 2026 机场推荐排行榜</span>
              <Icon name="material-symbols:arrow-forward-rounded" size={14} />
            </a>
          </div>
        </SpotlightCard>

        <!-- Card 3: Real Speedtest Evidence Gallery -->
        <SpotlightCard themeColor="#10b981" class="group p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-emerald-500 mb-2 flex items-center gap-1">
              <Icon name="material-symbols:speed-outline-rounded" size={16} />
              <span>真实测速快照</span>
            </div>
            <h3 class="text-2xl font-black text-foreground mb-2">
              17 份节点实测大图中心
            </h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mb-4">
              覆盖晚高峰核心时段，包含光速云、飞猫云、微风网络、星岛梦等 17 家服务商 1122×1402 原尺寸测速记录，证据确凿可溯源。
            </p>
          </div>

          <div class="pt-4 border-t border-border">
            <a
              href={getRelativeLocaleUrl(locale, "/speedtest/")}
              class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white transition"
            >
              <span>进入测速实测大图库 ({speedtestedAirports.length} 份)</span>
              <Icon name="material-symbols:arrow-forward-rounded" size={14} />
            </a>
          </div>
        </SpotlightCard>

        <!-- Card 4: Proxy Clients Hub -->
        <SpotlightCard themeColor="#8b5cf6" class="group p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold text-purple-500 mb-2 flex items-center gap-1">
              <Icon name="material-symbols:devices-outline-rounded" size={16} />
              <span>代理软件大全</span>
            </div>
            <h3 class="text-2xl font-black text-foreground mb-2">
              全平台客户端下载与教程
            </h3>
            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed mb-4">
              汇总 Clash Verge Rev、Shadowrocket（小火箭）、v2rayN、sing-box 等官方开源版本，手把手三步导入订阅指南。
            </p>
          </div>

          <div class="pt-4 border-t border-border">
            <a
              href={getRelativeLocaleUrl(locale, "/clients/")}
              class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 hover:bg-purple-500 hover:text-white transition"
            >
              <span>查看客户端配置大全</span>
              <Icon name="material-symbols:arrow-forward-rounded" size={14} />
            </a>
          </div>
        </SpotlightCard>
      </SpotlightCardsGallery>
    </Container>
  </section>

  <!-- Original Theme Category Posts Section (Radmin VPN Technical Heritage) -->
  <section class="pb-24">
    <Container>
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-black text-foreground flex items-center gap-2">
          <Icon name="material-symbols:shield-lock-outline-rounded" class="text-primary" size={24} />
          <span>Radmin VPN 虚拟组网专栏</span>
        </h2>
        <a href={getRelativeLocaleUrl(locale, "/post/")} class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
          <span>所有文章</span>
          <Icon name="material-symbols:arrow-forward-rounded" size={14} />
        </a>
      </div>

      {categoriesLists.some(list => list.posts.length > 0) && (
        <div class="flex flex-wrap gap-4">
          <SpotlightCardsGallery minCardWidth={700}>
            {
              categoriesLists.map((categoriesList) => categoriesList.posts.length ? (
                <SpotlightCard themeColor={uniqolor.random({ saturation: 90, lightness: [70, 90] }).color} class="group">
                  <div class="mb-8 flex flex-row items-center justify-between gap-2 md:flex-col md:items-start">
                    <h3
                      class="text-3xl font-bold opacity-90 group-hover:opacity-100 "
                    >
                      <a data-astro-prefetch href={getRelativeLocaleUrl(Astro.currentLocale || defaultLocale, `/post/categories/${categoriesList.type}/`)}>
                        {
                          (() => {
                            const snakedCategoryType = toSnakeCase(categoriesList.type)
                            const categoryI18nMethodName = `category_${snakedCategoryType}`;
                            const categoryTranslation = t(categoryI18nMethodName as TranslationKey);
                            if (categoryTranslation !== categoryI18nMethodName) {
                              return categoryTranslation;
                            }
                            return categoriesList.type;
                          })()
                        }
                      </a>
                    </h3>
                    <span class="opacity-60 transition-opacity group-hover:opacity-100">
                      {categoriesList.posts.length} 
                      {
                       categoriesList.posts.length > 1 ? t("suave_close_fireant_play") : t("busy_misty_skunk_praise")
                      }
                    </span>
                  </div>

                  <ul class="flex flex-col gap-4">
                    {categoriesList.posts.map(
                      (post, index) =>
                        index + 1 < 4 && (
                          <li class="group/list inline-flex gap-12">
                            <time
                              style="margin-top: 0.3em"
                              class="inline-block whitespace-nowrap opacity-80 group-hover/list:opacity-100 "
                            >
                              {post.data.publishDate
                                .toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit' })
                                .replace(/\//g, '-')}
                            </time>
                            <a
                              data-astro-prefetch
                              class="inline-block text-lg opacity-80 transition-opacity group-hover/list:opacity-100"
                              href={getRelativeLocaleUrl(Astro.currentLocale || defaultLocale, `/post/${stripLanguageCode(post.id)}/`)}
                            >
                              {post.data.headline}
                            </a>
                          </li>
                        ),
                    )}
                  </ul>
                </SpotlightCard>
              ) : null)
            }
          </SpotlightCardsGallery>
        </div>
      )}
    </Container>
  </section>
</BlogBase>
