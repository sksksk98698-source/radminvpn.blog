---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import Container from "@/components/atoms/container/Container.astro";
import Hero from "@/components/molecules/hero/Hero.astro";
import { featuredAirport } from "@/data/airports";
import BlogBase from "@/layouts/BlogBase.astro";
import { defaultLocale, languages } from "@/utils/i18n.ts";

export function getStaticPaths() {
	return Object.keys(languages).map((language) => ({
		params: { language },
	}));
}

const locale = Astro.currentLocale || defaultLocale;
const isZh = locale.startsWith("zh");

const title = isZh
  ? "2026 免费资源与开源网络工具全景导航【万字真实可用清单与白嫖节点避坑指南】"
  : "2026 Free Proxy Tools & Open-Source Network Directory (Comprehensive Guide)";

const description = isZh
  ? "汇总真实可用的正规免费虚拟组网工具、开源代理客户端官方下载源以及知名机场免费试用福利。深入揭秘公开免费节点的安全陷阱，提供从白嫖平滑过渡至高性价比专线的完整决策方案。"
  : "Verified directory of open-source VPN tools, official client releases, and authentic proxy trials. In-depth analysis of public free proxy risks and budget-friendly upgrade paths.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `https://radminvpn.blog/${locale}/free/`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": isZh ? "首页" : "Home",
        "item": `https://radminvpn.blog/${locale}/`
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": isZh ? "免费资源" : "Free Tools",
        "item": `https://radminvpn.blog/${locale}/free/`
      }
    ]
  }
};
---

<BlogBase title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Hero>
    <div slot="beforeHeadline" class="mx-auto flex items-center gap-2">
      <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-2">
        <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>可核实真实资源库 · 持续更新</span>
