---
import Container from "@/components/atoms/container/Container.astro";
---

<section class="bg-cover bg-center bg-no-repeat sm:pt-[var(--mainNav-height)] text-left md:text-center">
  <Container>
    <div class="px-4 sm:px-6 flex flex-col gap-8 sm:gap-12 py-12 sm:py-16 md:py-20">
      <div class="flex flex-col gap-4 items-center">
        <slot name="beforeHeadline" />
        <h1 class="text-3xl md:text-6xl font-black tracking-tight text-center">
          <slot name="headline" />
        </h1>
      </div>
      <slot />
    </div>
  </Container>
</section>
