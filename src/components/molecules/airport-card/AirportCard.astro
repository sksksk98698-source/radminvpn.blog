---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import type { AirportBrand } from "@/types/airport";
import { defaultLocale } from "@/utils/i18n.ts";

export interface Props {
  brand: AirportBrand;
  locale?: string;
}

const { brand, locale = Astro.currentLocale || defaultLocale } = Astro.props;
const detailHref = getRelativeLocaleUrl(locale, `/airports/${brand.id}/`);
---

<div class={`relative flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 ${brand.isFeatured ? 'bg-gradient-to-b from-primary/10 via-background to-background border-primary/50 shadow-[0_0_25px_-5px_rgba(58,134,255,0.25)] ring-1 ring-primary/40' : 'bg-card/60 hover:bg-card border-border hover:border-primary/40 shadow-sm hover:shadow-md'}`}>
  {brand.isFeatured && (
    <div class="absolute -top-3 left-6 px-3 py-0.5 rounded-full text-xs font-bold bg-primary text-primary-foreground shadow-sm flex items-center gap-1">
      <Icon name="material-symbols:award-star-outline-rounded" size={16} />
      <span>全站第一主推 · 综合第一名</span>
    </div>
  )}

  <div>
    <!-- Card Header -->
    <div class="flex items-start justify-between gap-3 mb-4 mt-1">
      <div>
        <div class="flex items-center gap-2">
          <span class={`flex items-center justify-center size-7 rounded-lg text-xs font-bold ${brand.rank === 1 ? 'bg-primary text-primary-foreground' : (brand.rank <= 3 ? 'bg-amber-500 text-black' : 'bg-muted text-muted-foreground')}`}>
            #{brand.rank}
          </span>
          <h3 class="text-xl font-bold tracking-tight text-foreground hover:text-primary transition-colors">
            <a href={detailHref}>{brand.name}</a>
          </h3>
        </div>
        <p class="text-xs text-muted-foreground mt-1 line-clamp-1">{brand.uniqueSellingPoint}</p>
      </div>

      <div class="text-right whitespace-nowrap">
        <div class="text-base font-extrabold text-primary">{brand.startingPrice}</div>
        <div class="text-[11px] text-muted-foreground">{brand.billingType}</div>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {brand.lineTypes.map(lt => (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-primary/10 text-primary border border-primary/20">
          {lt}
        </span>
      ))}
      {brand.protocols.slice(0, 2).map(p => (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-muted text-muted-foreground">
          {p}
        </span>
      ))}
      {brand.speedtest && (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 flex items-center gap-0.5">
          <Icon name="material-symbols:bolt-outline-rounded" size={13} />
          <span>含实测大图</span>
        </span>
      )}
      {brand.couponCode && (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
          码: {brand.couponCode}
        </span>
      )}
    </div>

    <!-- Highlights -->
    <ul class="space-y-1.5 text-xs text-muted-foreground mb-6">
      {brand.pros.slice(0, 3).map(pro => (
        <li class="flex items-center gap-1.5 line-clamp-1">
          <Icon name="material-symbols:check-circle-outline-rounded" class="text-emerald-500 shrink-0" size={15} />
          <span>{pro}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Action CTAs -->
  <div class="flex items-center gap-2 pt-3 border-t border-border/60">
    <a
      href={brand.affUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm transition"
    >
      <span>官网直达</span>
      <Icon name="material-symbols:open-in-new-rounded" size={14} />
    </a>
    <a
      href={detailHref}
      class="inline-flex items-center justify-center px-3 py-2 rounded-xl text-xs font-medium border border-border hover:bg-muted text-foreground transition"
    >
      <span>深度测评</span>
    </a>
  </div>
</div>
