---
import { Icon } from "astro-icon/components";

export interface Props {
  images: string[];
  brandName: string;
}

const { images, brandName } = Astro.props;
---

<div class="my-8 rounded-2xl border border-border bg-card/60 overflow-hidden shadow-sm">
  <div class="p-4 sm:p-5 border-b border-border bg-muted/30 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <div class="p-2 rounded-xl bg-primary/10 text-primary">
        <Icon name="material-symbols:smart-display-outline-rounded" size={20} />
      </div>
      <div>
        <h4 class="text-sm sm:text-base font-bold text-foreground">
          {brandName} 流媒体与 AI 工具解锁实测
        </h4>
        <p class="text-xs text-muted-foreground mt-0.5">原生 IP 节点 · 支持 ChatGPT / Claude / Netflix / TikTok 直播</p>
      </div>
    </div>
    <span class="text-xs px-2.5 py-1 rounded-md bg-primary/10 text-primary font-medium">5 项实测</span>
  </div>

  <div class="p-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
    {images.map((img, idx) => (
      <a href={img} target="_blank" rel="noopener" class="group relative overflow-hidden rounded-xl border border-border shadow-sm block aspect-video bg-black/5 dark:bg-black/30">
        <img
          src={img}
          alt={`${brandName} 解锁实测证据图 ${idx + 1}`}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold gap-1">
          <Icon name="material-symbols:fullscreen-rounded" size={18} />
          <span>查看实测图</span>
        </div>
      </a>
    ))}
  </div>
</div>
